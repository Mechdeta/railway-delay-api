# Environment variables for Railway Delay API
# Copy this file to .env and fill in the values

PORT=3000
NODE_ENV=development
# Example API key (if needed in future)
# API_KEY=your_api_key_here

# x402 Payment Configuration (Base Sepolia testnet)
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=0xYOUR_TESTNET_WALLET_ADDRESS
X402_PARSE_PRICE=$0.001
X402_BULK_PRICE=$0.005

# Buyer Client Configuration
BUYER_PRIVATE_KEY=0xYOUR_BUYER_PRIVATE_KEY_HERE
API_URL=http://localhost:3000